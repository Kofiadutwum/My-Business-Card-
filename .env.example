# Copy to .env and fill in. Never commit .env.
FLASK_CONFIG=development
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32

SITE_NAME=AD Smart Business Cards
SITE_SHORT_NAME=AD Smart
SITE_URL=http://127.0.0.1:5000
SUPPORT_EMAIL=adgraphics881@gmail.com
SUPPORT_PHONE=0545875881

DATABASE_URL=sqlite:///instance/cardhub.db

CURRENCY=GHS
GRACE_PERIOD_DAYS=7
RENEWAL_NOTICE_DAYS=30

# Payments -------------------------------------------------------------
# PAYMENT_SANDBOX=1 simulates the whole flow with no gateway account,
# which is how you demo the site before Paystack verifies your business.
PAYMENT_SANDBOX=1
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# SMS -------------------------------------------------------------------
# 'console' prints messages instead of sending them. Change only when you
# have registered and had approved an alphanumeric sender ID with your
# provider — an unregistered sender ID reports success and delivers nothing.
# Options: console | arkesel | mnotify | hubtel
SMS_PROVIDER=console
SMS_SENDER_ID=ADSMART
SMS_API_KEY=
# Hubtel only:
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=

# Lead capture ----------------------------------------------------------
LEADS_ENABLED=1
LEADS_PER_VISITOR_PER_HOUR=3
